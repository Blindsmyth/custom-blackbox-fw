--- a/src/faster/PercussiveAudioCurve.cpp
+++ b/src/faster/PercussiveAudioCurve.cpp
@@ -69,10 +69,19 @@ PercussiveAudioCurve::processFloat(const float *R__ mag, int)
     const int sz = m_lastPerceivedBin;
 
     for (int n = 1; n <= sz; ++n) {
+#ifdef RB_FIXED_PITCH
+        // RB_FIXED_PITCH (Blackbox build): mag / prev >= threshold as a
+        // multiply, in float: upstream divides in double for every bin.
+        float pm = float(m_prevMag[n]);
+        bool above;
+        if (pm > zeroThresh) above = (mag[n] >= threshold * pm);
+        else above = (mag[n] > zeroThresh);
+#else
         float v = 0.f;
         if (m_prevMag[n] > zeroThresh) v = mag[n] / m_prevMag[n];
         else if (mag[n] > zeroThresh) v = threshold;
         bool above = (v >= threshold);
+#endif
         if (above) ++count;
         if (mag[n] > zeroThresh) ++nonZeroCount;
     }
