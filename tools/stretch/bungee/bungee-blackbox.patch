diff --git a/src/FastPhase.h b/src/FastPhase.h
new file mode 100644
index 0000000..0862600
--- /dev/null
+++ b/src/FastPhase.h
@@ -0,0 +1,57 @@
+// Blackbox (BUNGEE_FAST_PHASE): the per-bin trig in Stretcher without libm.
+// atan2 as an odd minimax polynomial on [0, 1] with octant folding (max error ~1e-5 rad, under
+// a tenth of one Phase::Type step, 9.6e-5 rad); the unit phasor exp(i r pi / 32768) of an int16
+// rotation by quarter-wave reduction and Taylor polynomials (error ~1e-6). On the Cortex-M7 these
+// replace atan2f/cexpf/sinf/cosf, ~25 % of the render's instructions, all of it libm in flash.
+#pragma once
+
+#include "Phase.h"
+
+#include <complex>
+#include <cstdint>
+#include <numbers>
+
+namespace Bungee::FastPhase {
+
+static inline float atan2(float y, float x)
+{
+	const float ax = x < 0.f ? -x : x, ay = y < 0.f ? -y : y;
+	const float mx = ax > ay ? ax : ay, mn = ax > ay ? ay : ax;
+	if (mx == 0.f)
+		return 0.f;
+	const float z = mn / mx, z2 = z * z;
+	float a = z * (0.99997726f + z2 * (-0.33262347f + z2 * (0.19354346f + z2 * (-0.11643287f + z2 * (0.05265332f + z2 * -0.01172120f)))));
+	if (ay > ax)
+		a = std::numbers::pi_v<float> / 2 - a;
+	if (x < 0.f)
+		a = std::numbers::pi_v<float> - a;
+	return y < 0.f ? -a : a;
+}
+
+// Phase::fromRadians(std::arg(c)), the same truncation.
+static inline Phase::Type fromComplex(std::complex<float> c)
+{
+	return Phase::fromRadians(atan2(c.imag(), c.real()));
+}
+
+// exp(i * rotation * pi / 32768) for an int16 rotation.
+static inline std::complex<float> unit(Phase::Type rotation)
+{
+	const uint16_t u = uint16_t(rotation);
+	const float x = float(u & 0x3fff) * (std::numbers::pi_v<float> / 32768.f), x2 = x * x;
+	const float s = x * (1.f + x2 * (-1.f / 6 + x2 * (1.f / 120 + x2 * (-1.f / 5040 + x2 * (1.f / 362880)))));
+	const float c = 1.f + x2 * (-0.5f + x2 * (1.f / 24 + x2 * (-1.f / 720 + x2 * (1.f / 40320 + x2 * (-1.f / 3628800)))));
+	switch (u >> 14)
+	{
+	case 0:
+		return {c, s};
+	case 1:
+		return {-s, c};
+	case 2:
+		return {-c, -s};
+	default:
+		return {s, -c};
+	}
+}
+
+} // namespace Bungee::FastPhase
